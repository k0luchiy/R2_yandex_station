# R2D2 -- environment for the Alice skill server.
#
#   cp .env.example .env && chmod 0600 .env && $EDITOR .env
#
# `.env` holds THREE live credentials (the OpenRouter key, the Telegram bot token
# and the opencode server password) and is git-ignored. Never commit it, never
# paste its values into a test, a log or an issue. `tests/test_no_secrets_tracked.py`
# walks every tracked file on every test run and fails if a credential shape or a
# live value from this file appears in one.
#
# Every variable below is read by `app/config.py:Config.load()`, which uppercases
# the dataclass field name -- so the variable name IS the field name in caps. A
# name this file gets wrong is a setting that silently does nothing, which is why
# the test suite reflects over the dataclass and requires every field to appear
# here. Read the value column: `live` means the code reads it, `declared only`
# means `Config` still declares the field but nothing reads it any more.

# --- which backend answers, and in what order ------------------------------
# The order and the membership of the chain live in config/backends.json
# (chain: opencode -> zen -> yandexgpt -> openrouter), NOT here.

# declared only. Left over from the hardcoded provider factory that todo 5
# deleted. Setting it changes nothing.
LLM_PROVIDER=openrouter
# declared only, same reason.
FALLBACK_PROVIDER=

# --- OpenRouter: third in the fallback chain --------------------------------

# live. config/backends.json expands ${OPENROUTER_API_KEY} into the openrouter
# entry. Leave it empty and that entry is dropped from the chain with a WARNING
# naming the field -- the other backends keep working.
OPENROUTER_API_KEY=
# declared only. The model id is the `model` field of the openrouter entry in
# config/backends.json; this variable is not read.
OPENROUTER_MODEL=deepseek/deepseek-chat
# declared only. The base URL likewise comes from config/backends.json.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- YandexGPT: last in the fallback chain ----------------------------------

# live, and only if you want the yandexgpt entry to work: config/backends.json
# expands ${YANDEX_API_KEY} and ${YANDEX_FOLDER_ID} into it.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# declared only -- base_url, model and auth mode come from config/backends.json.
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/foundationModels/v1
YANDEX_AUTH_MODE=api_key
YANDEX_MODEL=yandexgpt-lite-5
YANDEX_MODEL_BIG=yandexgpt-pro-5.1

# --- Telegram: where a long answer and every permission question go ---------

# live, a credential. The bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# live. Your own numeric chat id. The server accepts /tg/webhook only for this
# id, so an empty value disables the Telegram entry point entirely.
TELEGRAM_CHAT_ID=

# --- Alice skill authorisation ----------------------------------------------

# live. Without both of these the skill rejects every request as not yours.
ALICE_SKILL_ID=
ALICE_USER_ID=

# --- listener ---------------------------------------------------------------

# live in scripts/run_server.sh ONLY, and only from the shell environment: the
# launcher interpolates ${SERVER_HOST:-0.0.0.0} before python starts, so a value
# here does not move the listener -- `SERVER_PORT=9090 .venv/bin/uvicorn ...`
# does. `Config` declares both fields; the app itself reads neither.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- state ------------------------------------------------------------------

# live. SQLite file holding sessions and per-user history. A relative path is
# resolved against the repository root and the parent directory is created.
DB_PATH=db/sessions.db

# --- shell tool -------------------------------------------------------------

SHELL_ENABLED=true
# live. When true, a command classified as risky is spoken back for spoken
# confirmation instead of running.
SHELL_REQUIRE_CONFIRM=true
# live, in seconds. Renamed from SHELL_TIMEOUT_SECONDS: the old name is not a
# Config field, so a `.env` still carrying it has been running on the 10.0
# default and will keep doing so. Rename it or delete it.
SHELL_TIMEOUT=10.0

# --- LLM turn shape ---------------------------------------------------------

# live, in seconds. One round of the brain; the fast voice path additionally
# bounds itself with R2D2_FAST_DEADLINE.
LLM_TIMEOUT=3.0
LLM_MAX_TOKENS=400
# live. How many past messages of a conversation are replayed to the model.
MAX_HISTORY=20

# --- the opencode backend (plan opencode-brain.md, todos 2 and 15) ----------

# live. The backend registry, read by core/backends/config_loader.py. This is
# where the chain, the base URLs, the model ids and the agent names live; every
# ${VAR} in it is expanded from THIS file's environment.
BACKENDS_PATH=config/backends.json

# live, in seconds. How long the tool-less voice agent may take before R2D2
# stops waiting and speaks the acknowledgement instead. Alice's own limit is
# 4.5 s, so this must stay well under it.
R2D2_FAST_DEADLINE=3.2

# live. Spoken the moment a question is judged too big for the voice path; the
# real answer arrives in Telegram.
R2D2_TASK_ACK=Проверяю, пришлю в телеграм.

# live. The literal the voice agent must emit for R2D2 to escalate instead of
# answering. It is stripped from anything Alice is told, so it never reaches
# speech -- change it and you must change it in
# config/opencode/r2d2.opencode.json too.
R2D2_NEEDS_AGENT_SENTINEL=[[NEEDS_AGENT]]

# declared only. The two agent names the brain addresses are the `voice_agent`
# and `task_agent` fields of the opencode entry in config/backends.json, and the
# agent definitions themselves are in config/opencode/r2d2.opencode.json. These
# two fields are not read; they are kept so the names are discoverable here.
R2D2_VOICE_AGENT=r2d2-voice
R2D2_TASK_AGENT=r2d2-agent

# live. The directory the opencode session runs in, and therefore the root of
# every file the agent may touch. It must already exist: R2D2 refuses to start
# an opencode session whose workspace is missing.
R2D2_WORKSPACE=/home/koluchiy/r2d2-workspace

# live, in seconds. How long a permission question stays open before R2D2
# rejects it for the agent. It is never answered `always`, so a timeout costs
# the agent one denied step and nothing else.
R2D2_PERMISSION_TIMEOUT=300.0

# live. How many turns one opencode session accumulates before the brain starts
# a fresh one. A soft limit: the old session stays on disk.
R2D2_SESSION_SOFT_LIMIT=40

# live, in seconds. A session untouched for this long is treated as a zombie
# and reaped; the reaper may safely run more often, it only costs requests.
R2D2_STALE_SESSION_SECONDS=900.0

# declared only. Where scripts/install_r2d2_opencode_config.sh installs the
# local CLI shim the agent is allowed to run. The path that actually decides
# what runs is the bash allowlist in config/opencode/r2d2.opencode.json, which
# spells this path out literally -- change one, change both.
R2D2_CLI_PATH=/home/koluchiy/.r2d2/r2d2_do.py

# live, in seconds. How often the opencode-session backend polls for events
# when it is not on the SSE stream. Ignored in sse mode.
R2D2_EVENT_POLL_INTERVAL=2.0

# live. Which human the Telegram chat belongs to, written as `chat_id=application_id`
# -- for example `1087136471=alice-main`, with the SAME application_id that person's
# Alice turns carry. It is a declaration, not a derivation, because one person owns
# one opencode session and one pending permission question: Alice asks the question
# in Telegram and Telegram carries the answer, and both halves are keyed by the
# application id. R2D2 will NOT fall back to `tg:<chat_id>` -- that is how one human
# ended up with a second session, and how «да» was answered in a session the
# question had never been asked in (qa/live-run.md §4c).
#
# A chat that is not named here has no identity: the message is dropped with a
# WARNING naming this variable, and no session is created for it. A token this
# build cannot read binds nothing and is also a WARNING. Several pairs may be
# listed, separated by commas or spaces, when a second chat is really a second
# person. An application id may not contain a space: it is an opaque id from Alice.
R2D2_TG_APPLICATION_ID=

# --- the Zen fallback credential --------------------------------------------

# live, a credential, and the only variable here that `Config` does NOT declare:
# core/backends/config_loader.py expands ${R2D2_ZEN_KEY} straight from the
# environment into the zen entry of config/backends.json.
#
# Its value is the `opencode` entry of ~/.local/share/opencode/auth.json (the
# credential `opencode` itself authenticates with), or the key from the Zen
# console. It is needed ONLY for the fallback chain: the opencode route talks to
# your own `opencode serve` over loopback with HTTP basic auth and never reads
# this. Leave it empty and the zen entry is dropped from the chain with a
# WARNING; the opencode route, which is first in the chain, is unaffected.
R2D2_ZEN_KEY=

# --- the opencode server's own environment: .env.oc, not this file -----------

# `opencode serve` runs from scripts/r2d2-opencode.service, which reads .env.oc
# -- a separate file, git-ignored, mode 0600, documented in .env.oc.example.
# That is where R2D2_OC_PORT, R2D2_OC_USERNAME, R2D2_OC_PASSWORD and
# R2D2_OC_WORKSPACE belong, and where the password is generated:
#
#   cp .env.oc.example .env.oc && chmod 0600 .env.oc
#   openssl rand -base64 24
#
# R2D2 authenticates to that server as a CLIENT, and config/backends.json
# expands the same two names from THIS file's environment -- so the values must
# exist in both places. They are left commented out here on purpose: a line
# present but empty expands to an empty password, which the launcher would
# refuse anyway, whereas a missing variable drops the opencode entry from the
# chain with a WARNING that names it. Fail loudly, not silently.
# R2D2_OC_USERNAME=opencode
# R2D2_OC_PASSWORD=
